msgid "Scarica il file <code>index.php</code> qui sotto (specifico per i temi)."
msgstr "Download the <code>index.php</code> file below (theme-specific)."

msgid "Carica i file <code>.zip</code> dei tuoi temi nella stessa cartella."
msgstr "Upload your theme <code>.zip</code> files to the same folder."

msgid "Inserisci l'URL della cartella (es. <code>https://tuosito.com/my-repo/themes/</code>) nelle Impostazioni di questo plugin."
msgstr "Enter the folder URL (e.g. <code>https://your-site.com/my-repo/themes/</code>) in this plugin's Settings."

msgid "Scarica index.php per Temi"
